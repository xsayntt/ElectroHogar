<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bad215.electrohogar.controller.LoginController">
   <children>
      <!-- Contenedor principal del formulario de Login -->
      <VBox alignment="CENTER" layoutX="150.0" layoutY="35.0" prefHeight="330.0" prefWidth="300.0" spacing="15.0" styleClass="login-card">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         <children>
            <!-- Título y subtítulo -->
            <Label styleClass="login-title" text="ElectroHogar" />
            <Label styleClass="login-subtitle" text="Acceso al Sistema Corporativo" />
            
            <!-- Espaciador visual -->
            <VBox prefHeight="10.0" prefWidth="240.0" />

            <!-- Campo de Usuario -->
            <VBox spacing="5.0" styleClass="input-container">
               <children>
                  <Label styleClass="input-label" text="Usuario" />
                  <TextField fx:id="txtUsuario" promptText="Ingrese su usuario" styleClass="text-field" />
               </children>
            </VBox>

            <!-- Campo de Contraseña -->
            <VBox spacing="5.0" styleClass="input-container">
               <children>
                  <Label styleClass="input-label" text="Contraseña" />
                  <PasswordField fx:id="txtContrasena" promptText="Ingrese su contraseña" styleClass="password-field" />
               </children>
            </VBox>

            <!-- Botón de Inicio de Sesión -->
            <Button fx:id="btnIngresar" mnemonicParsing="false" onAction="#onIngresar" prefHeight="32.0" prefWidth="240.0" styleClass="login-button" text="Iniciar Sesión" />
         </children>
      </VBox>
   </children>
</AnchorPane>
