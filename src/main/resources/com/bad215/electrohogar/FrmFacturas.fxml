<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" prefHeight="640.0" prefWidth="980.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bad215.electrohogar.controller.FacturasController">
    <content>
        <VBox spacing="14.0" style="-fx-background-color: white;">
            <padding>
                <Insets bottom="24.0" left="28.0" right="28.0" top="20.0" />
            </padding>

            <Label text="Facturas" style="-fx-font-size: 22px; -fx-font-weight: bold;" />

            <!-- Fecha y datos del usuario activo -->
            <VBox spacing="2.0">
                <Label fx:id="lblFechaActual" text="Fecha: " style="-fx-font-size: 13px;" />
                <Label fx:id="lblUsuarioActivo" text="Usuario: " style="-fx-font-size: 13px;" />
            </VBox>

            <!-- Buscador (sp_listar_facturas) y botón para crear factura -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <TextField fx:id="txtBuscarFactura" prefHeight="36.0" prefWidth="420.0"
                           promptText="Buscar por N° de factura, cliente o empleado"
                           onAction="#buscarFacturas"
                           style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #c9d0da; -fx-padding: 0 14 0 14;" />
                <Button fx:id="btnBuscarFactura" mnemonicParsing="false" onAction="#buscarFacturas"
                        prefHeight="36.0" prefWidth="110.0" text="Buscar"
                        style="-fx-background-color: #4f6bff; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 13px; -fx-cursor: hand;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnCrearFactura" mnemonicParsing="false" onAction="#crearFactura"
                        prefHeight="36.0" prefWidth="170.0" text="Crear factura"
                        style="-fx-background-color: #3a4fc4; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 13px; -fx-cursor: hand;" />
            </HBox>

            <!-- Tabla con los datos de sp_listar_facturas -->
            <TableView fx:id="tblFacturas" prefHeight="400.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNumeroFactura" minWidth="70" prefWidth="90" text="N° factura" />
                    <TableColumn fx:id="colCliente" minWidth="130" prefWidth="180" text="Cliente" />
                    <TableColumn fx:id="colTipoCliente" minWidth="70" prefWidth="90" text="Tipo" />
                    <TableColumn fx:id="colEmpleado" minWidth="130" prefWidth="170" text="Registrada por" />
                    <TableColumn fx:id="colFecha" minWidth="130" prefWidth="150" text="Fecha y hora" />
                    <TableColumn fx:id="colEstado" minWidth="70" prefWidth="90" text="Estado" />
                    <TableColumn fx:id="colMetodoPago" minWidth="120" prefWidth="150" text="Método de pago" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <placeholder>
                    <Label text="No hay facturas para mostrar." />
                </placeholder>
            </TableView>
        </VBox>
    </content>
</ScrollPane>
