<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="720.0" spacing="12.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" 
stylesheets="@style.css" fx:controller="com.bad215.electrohogar.controller.SeleccionarClienteController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="18.0" />
    </padding>

    <Label styleClass="titulo-seccion" text="Seleccionar cliente" />

    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <TextField fx:id="txtBuscar" onAction="#buscar" prefHeight="32.0" promptText="Nombre, documento o ID" HBox.hgrow="ALWAYS" />
        <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscar" prefHeight="32.0" prefWidth="80.0" text="Buscar" styleClass="btn-buscar"/>
    </HBox>

    <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" minWidth="40" prefWidth="60" text="ID" />
            <TableColumn fx:id="colNombre" minWidth="160" prefWidth="260" text="Nombre" />
            <TableColumn fx:id="colTelefono" minWidth="90" prefWidth="120" text="Tipo" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <placeholder>
            <Label text="Busca un cliente por nombre, documento o ID." />
        </placeholder>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Button fx:id="btnCancelar" cancelButton="true" mnemonicParsing="false" onAction="#cancelar" prefHeight="32.0" prefWidth="100.0" text="Cancelar" />
        <Button fx:id="btnSeleccionar" defaultButton="false" disable="true" mnemonicParsing="false" onAction="#seleccionar" prefHeight="32.0" prefWidth="120.0" text="Seleccionar" />
    </HBox>
</VBox>