<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="760.0" prefWidth="1180.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bad215.electrohogar.controller.FacturasDetalleController">
    <content>
        <VBox spacing="16.0" styleClass="factura-root">
            <padding>
                <Insets bottom="24.0" left="28.0" right="28.0" top="20.0" />
            </padding>

            <Label styleClass="titulo-pantalla" text="Nueva factura" />

	<!-- ===== Datos de cabecera: mismas columnas que el cuerpo ===== -->
<HBox spacing="28.0">
    <!-- Izquierda: cliente -->
    <VBox minWidth="520.0" prefWidth="680.0" spacing="4.0" HBox.hgrow="ALWAYS">
        <Label text="Cliente" />
        <HBox spacing="8.0">
            <TextField fx:id="txtCliente" editable="false" prefHeight="32.0" promptText="Presiona el boton para seleccionar un cliente" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnSeleccionarCliente" mnemonicParsing="false" onAction="#seleccionarCliente" prefHeight="32.0" prefWidth="110.0" text="Seleccionar" styleClass="btn-buscar" />
        </HBox>
    </VBox>

<!-- Derecha: método de pago y cuotas -->
    <HBox minWidth="400.0" prefWidth="460.0" spacing="18.0" HBox.hgrow="ALWAYS">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label text="Método de pago" />
            <ComboBox fx:id="cmbMetodoPago" maxWidth="Infinity" onAction="#metodoPagoSeleccionado" prefHeight="32.0" promptText="Selecciona un método" />
        </VBox>
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label text="Cantidad de cuotas" />
            <TextField fx:id="txtCuotas" disable="true" maxWidth="Infinity" prefHeight="32.0" promptText="Solo si es crédito" />
        </VBox>
    </HBox>
</HBox>
            <!-- ===== Cuerpo: productos disponibles (izquierda) y agregados (derecha) ===== -->
            <HBox spacing="28.0" VBox.vgrow="ALWAYS">

                <!-- Izquierda: productos disponibles, selección y cantidad -->
                <VBox minWidth="520.0" prefWidth="680.0" spacing="10.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="titulo-seccion" text="Productos disponibles" />
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <TextField fx:id="txtBuscarProducto" onAction="#buscarProducto" prefHeight="36.0" promptText="Nombre, descripción o categoría" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnBuscarProducto" mnemonicParsing="false" onAction="#buscarProducto" prefHeight="36.0" prefWidth="110.0" text="Buscar" styleClass="btn-buscar" />
                    </HBox>
                    <TableView fx:id="tblProductos" prefHeight="300.0" VBox.vgrow="ALWAYS">
                        <columns>
                           
                            <TableColumn fx:id="colProdNombre" minWidth="120" prefWidth="170" text="Producto" />
                            <TableColumn fx:id="colProdCategoria" minWidth="90" prefWidth="110" text="Categoría" />
                            <TableColumn fx:id="colProdPrecio" minWidth="70" prefWidth="80" text="Precio" />
                            <TableColumn fx:id="colProdPrecioVigente" minWidth="90" prefWidth="100" text="Precio vigente" />
                            <TableColumn fx:id="colProdStock" minWidth="50" prefWidth="60" text="Stock" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Buscar un producto para agregarlo a la factura." />
                        </placeholder>
                    </TableView>

                    <Label fx:id="lblProductoSeleccionado" text="Ningún producto seleccionado" />
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label text="Cantidad" />
                        <TextField fx:id="txtCantidad" prefHeight="36.0" prefWidth="90.0" promptText="1" />
                        <Button fx:id="btnAgregarProducto" mnemonicParsing="false" onAction="#agregarProducto" prefHeight="38.0" prefWidth="200.0" text="Agregar producto"
styleClass="btn-buscar" />
                    </HBox>
                </VBox>

                <!-- Derecha: productos agregados y totales -->
                <VBox minWidth="400.0" prefWidth="460.0" spacing="10.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="titulo-seccion" text="Productos agregados" />
                    <TableView fx:id="tblAgregados" prefHeight="300.0" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colAgId" minWidth="40" prefWidth="50" text="ID" />
                            <TableColumn fx:id="colAgNombre" minWidth="120" prefWidth="190" text="Producto" />
                            <TableColumn fx:id="colAgCantidad" minWidth="60" prefWidth="80" text="Cantidad" />
                            <TableColumn fx:id="colAgPrecio" minWidth="80" prefWidth="100" text="Precio unit." />
                            <TableColumn fx:id="colAgSubtotal" minWidth="80" prefWidth="100" text="Subtotal" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Aún no se han agregado productos." />
                        </placeholder>
                    </TableView>

                    <HBox alignment="CENTER_RIGHT">
                        <Button fx:id="btnQuitarProducto" disable="true" mnemonicParsing="false" onAction="#quitarProducto" prefHeight="34.0" prefWidth="170.0" text="Quitar producto" styleClass="btn-peligro"/>
                    </HBox>

                    <VBox alignment="CENTER_RIGHT" spacing="8.0">
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <Label text="Subtotal" />
                            <TextField fx:id="txtSubtotal" editable="false" prefHeight="36.0" prefWidth="160.0" promptText="0.00" />
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <Label text="Total" />
                            <TextField fx:id="txtTotal" editable="false" prefHeight="36.0" prefWidth="160.0" promptText="0.00" />
                        </HBox>
                    </VBox>
                </VBox>
            </HBox>

            <!-- ===== Acciones de la factura ===== -->
            <HBox alignment="CENTER_RIGHT" spacing="14.0">
                <Button fx:id="btnCancelar" cancelButton="true" mnemonicParsing="false" onAction="#cancelar" prefHeight="38.0" prefWidth="170.0" text="Cancelar" styleClass="btn-cancelar"/>
                <Button fx:id="btnProcederPago" defaultButton="true" mnemonicParsing="false" onAction="#procederPago" prefHeight="38.0" prefWidth="190.0" text="Proceder a pago" styleClass="btn-guardar"/>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
