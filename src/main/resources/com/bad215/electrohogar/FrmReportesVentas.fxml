<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" style="-fx-background-color: #f4f6f9;"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bad215.electrohogar.controller.ReportesVentasController">
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="18.0" />
    </padding>

    <Label text="Reportes" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #26384a;" />
    <Label text="Para ventas" style="-fx-font-size: 15px; -fx-text-fill: #34495e;" />

    <HBox alignment="CENTER_LEFT" spacing="12.0"
          style="-fx-background-color: #dce3eb; -fx-background-radius: 8;">
        <padding><Insets bottom="14.0" left="16.0" right="16.0" top="14.0" /></padding>
        <VBox spacing="5.0">
            <Label text="Período" style="-fx-font-weight: bold;" />
            <ComboBox fx:id="cmbPeriodo" prefWidth="185.0" />
        </VBox>
        <VBox spacing="5.0">
            <Label text="Desde" style="-fx-font-weight: bold;" />
            <DatePicker fx:id="dpDesde" prefWidth="145.0" />
        </VBox>
        <VBox spacing="5.0">
            <Label text="Hasta" style="-fx-font-weight: bold;" />
            <DatePicker fx:id="dpHasta" prefWidth="145.0" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button mnemonicParsing="false" onAction="#aplicarFiltros" text="Aplicar"
                prefHeight="38.0" prefWidth="120.0"
                style="-fx-background-color: #4f6bff; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 14px; -fx-cursor: hand;" />
    </HBox>

    <HBox spacing="18.0" VBox.vgrow="ALWAYS">
        <VBox spacing="10.0" prefWidth="350.0" minWidth="300.0">
            <Label text="Tipo de reporte" style="-fx-font-size: 15px; -fx-font-weight: bold;" />
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <ComboBox fx:id="cmbTipoVentas" HBox.hgrow="ALWAYS" prefWidth="170.0" />
                <Button fx:id="btnExportarVentas" mnemonicParsing="false" onAction="#exportarVentasPdf"
                        text="Exportar PDF" prefHeight="36.0" prefWidth="135.0"
                        style="-fx-background-color: #4f6bff; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand;" />
            </HBox>

            <Separator />

            <Label text="Reporte de facturas anuladas" style="-fx-font-size: 15px; -fx-font-weight: bold;" />
            <ComboBox fx:id="cmbEmpleado" prefWidth="330.0" promptText="Todos los empleados" />
            <HBox spacing="8.0">
                <Button mnemonicParsing="false" onAction="#vistaPreviaAnulaciones" text="Vista previa"
                        prefHeight="36.0" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #e7ebf0; -fx-text-fill: #26384a; -fx-background-radius: 20; -fx-cursor: hand;" />
                <Button fx:id="btnExportarAnulaciones" mnemonicParsing="false" onAction="#exportarAnulacionesPdf"
                        text="Exportar PDF" prefHeight="36.0" prefWidth="135.0"
                        style="-fx-background-color: #4f6bff; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand;" />
            </HBox>

            <Region VBox.vgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#limpiarCampos" text="Limpiar campos"
                    prefHeight="36.0" prefWidth="180.0"
                    style="-fx-background-color: #d9dde2; -fx-text-fill: #34495e; -fx-background-radius: 20; -fx-cursor: hand;" />
        </VBox>

        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTituloVista" text="Vista previa"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;" />
            <TableView fx:id="tblVistaPrevia" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-border-color: #c9d0da;">
                <placeholder>
                    <Label text="Aplica los filtros para ver el reporte." style="-fx-text-fill: #6b7280;" />
                </placeholder>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            <Label fx:id="lblEstado" text="Selecciona un reporte y aplica los filtros."
                   style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />
        </VBox>
    </HBox>
</VBox>
