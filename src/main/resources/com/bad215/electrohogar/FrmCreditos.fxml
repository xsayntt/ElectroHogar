<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="640.0" prefWidth="980.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bad215.electrohogar.controller.CreditosController">
    <content>
        <VBox spacing="16.0" styleClass="pantalla-root">
            <padding>
                <Insets bottom="24.0" left="28.0" right="28.0" top="20.0" />
            </padding>

            <Label styleClass="titulo-pantalla" text="Créditos y cuotas" />

            <!-- ===== Filtros de búsqueda ===== -->
            <HBox alignment="BOTTOM_LEFT" spacing="14.0">
                <VBox spacing="4.0">
                    <Label text="ID cliente" />
                    <TextField fx:id="txtClienteId" prefHeight="32.0" prefWidth="90.0" promptText="Ej. 1" />
                </VBox>
                <VBox spacing="4.0">
                    <Label text="N° factura" />
                    <TextField fx:id="txtNumeroFactura" prefHeight="32.0" prefWidth="100.0" promptText="Ej. 100" />
                </VBox>
                <VBox spacing="4.0">
                    <Label text="DUI" />
                    <TextField fx:id="txtDui" prefHeight="32.0" prefWidth="130.0" promptText="00000000-0" />
                </VBox>
                <VBox spacing="4.0">
                    <Label text="NIT" />
                    <TextField fx:id="txtNit" prefHeight="32.0" prefWidth="170.0" promptText="0000-000000-000-0" />
                </VBox>
                <VBox spacing="4.0">
                    <Label text="Estado" />
                    <ComboBox fx:id="cmbEstado" prefHeight="32.0" prefWidth="140.0" />
                </VBox>
                <Button fx:id="btnBuscar" defaultButton="true" mnemonicParsing="false" onAction="#handleBuscar" prefHeight="32.0" prefWidth="80.0" text="Buscar" styleClass="btn-buscar"/>
            </HBox>

            <!-- ===== Tabla de cuotas ===== -->
            <TableView fx:id="tblCuotas" prefHeight="400.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colFactura" minWidth="70" prefWidth="80" text="N° factura" />
                    <TableColumn fx:id="colIdCuota" minWidth="60" prefWidth="70" text="ID cuota" />
                    <TableColumn fx:id="colNumCuota" minWidth="60" prefWidth="70" text="Cuota N°" />
                    <TableColumn fx:id="colCantCuotas" minWidth="70" prefWidth="80" text="Total cuotas" />
                    <TableColumn fx:id="colVencimiento" minWidth="90" prefWidth="110" text="Vencimiento" />
                    <TableColumn fx:id="colMonto" minWidth="80" prefWidth="90" text="Monto ($)" />
                    <TableColumn fx:id="colDui" minWidth="90" prefWidth="110" text="DUI" />
                    <TableColumn fx:id="colNit" minWidth="110" prefWidth="130" text="NIT" />
                    <TableColumn fx:id="colEstado" minWidth="80" prefWidth="100" text="Estado" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <placeholder>
                    <Label text="Busque un cliente o una factura para ver sus cuotas y proceder al pago." />
                </placeholder>
            </TableView>

            <!-- ===== Acciones de pago ===== -->
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Método de pago" />
                <ComboBox fx:id="cmbMetodoPago" prefHeight="32.0" prefWidth="180.0" />
                <Button fx:id="btnPagar" mnemonicParsing="false" onAction="#handlePagar" prefHeight="32.0" prefWidth="180.0" text="Pagar cuota seleccionada" styleClass="btn-guardar"/>
            </HBox>
        </VBox>
    </content>
</ScrollPane>