<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bad215.electrohogar.controller.CreditosController">
   
   <!-- TOP: Filtros y Búsqueda -->
   <top>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Módulo de Gestión de Créditos y Cuotas" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <VBox spacing="3.0">
                     <children>
                        <Label text="ID Cliente" />
                        <TextField fx:id="txtClienteId" prefWidth="90.0" promptText="Ej. 1" />
                     </children>
                  </VBox>
                  <VBox spacing="3.0">
                     <children>
                        <Label text="N° Factura" />
                        <TextField fx:id="txtNumeroFactura" prefWidth="90.0" promptText="Ej. 100" />
                     </children>
                  </VBox>
                  <VBox spacing="3.0">
                     <children>
                        <Label text="DUI" />
                        <TextField fx:id="txtDui" prefWidth="110.0" promptText="00000000-0" />
                     </children>
                  </VBox>
                  <VBox spacing="3.0">
                     <children>
                        <Label text="NIT" />
                        <TextField fx:id="txtNit" prefWidth="130.0" promptText="0000-000000-000-0" />
                     </children>
                  </VBox>
                  <VBox spacing="3.0">
                     <children>
                        <Label text="Estado" />
                        <ComboBox fx:id="cmbEstado" prefWidth="120.0" />
                     </children>
                  </VBox>
                  <Button fx:id="btnBuscar" defaultButton="true" mnemonicParsing="false" onAction="#handleBuscar" text="Buscar" translateY="8.0" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   
   <!-- CENTER: Tabla de Resultados -->
   <center>
      <TableView fx:id="tblCuotas" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colFactura" prefWidth="75.0" text="N° Factura" />
          <TableColumn fx:id="colIdCuota" prefWidth="65.0" text="ID Cuota" />
            <TableColumn fx:id="colNumCuota" prefWidth="65.0" text="Cuota N°" />
            <TableColumn fx:id="colCantCuotas" prefWidth="75.0" text="Total Cuotas" />
            <TableColumn fx:id="colVencimiento" prefWidth="110.0" text="Vencimiento" />
            <TableColumn fx:id="colMonto" prefWidth="90.0" text="Monto ($)" />
            <TableColumn fx:id="colDui" prefWidth="110.0" text="DUI" />
            <TableColumn fx:id="colNit" prefWidth="130.0" text="NIT" />
            <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
        </columns>
         <BorderPane.margin>
            <Insets bottom="10.0" left="15.0" right="15.0" />
         </BorderPane.margin>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <placeholder>
            <Label style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" text="Busque un cliente o una factura para ver sus cuotas y proceder al pago." />
         </placeholder>
      </TableView>
   </center>
   
   <!-- BOTTOM: Acciones de Pago -->
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="5.0" />
         </padding>
         <children>
            <Label text="Método de Pago:" />
            <ComboBox fx:id="cmbMetodoPago" prefWidth="180.0" />
            <Button fx:id="btnPagar" mnemonicParsing="false" onAction="#handlePagar" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;" text="Pagar Cuota Seleccionada" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
